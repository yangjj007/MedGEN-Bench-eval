# This repository was extracted from a larger experiment workspace. Ignore
# everything by default, then allow only the maintained public release files.
/*

# Release documentation and metadata.
!/.gitignore
!/README.md
!/LICENSE
!/NOTICE
!/SECURITY.md
!/CONTRIBUTING.md

# Reproducible runtime and evaluation entry points.
!/requirements-base.txt
!/requirements-eval.txt
!/requirements-lock-py310-cu13.txt
!/requirements-local-vllm.txt
!/requirements-local-image.txt
!/agent.py
!/inference.py
!/eval.py
!/prepare_medgen_tableiv.py
!/vllm_serve.sh
!/qwen_image_edit_serve.sh
!/download_medgen_dataset.sh
!/download_medimageinsight.sh

# Public test suite.
!/test_tableiv_integration.py
!/test_metrics_smoke.py
!/test_clinical_text_metrics.py
!/test_eval_clinical_integration.py
!/test_clinical_image_metrics.py

# Public API client helpers. Re-ignore the directory after opening its parent
# so local configurations, fixtures, and scratch scripts cannot be added.
!/api/
/api/*
!/api/__init__.py
!/api/config.example.yaml
!/api/config.vllm.yaml
!/api/config.qwen-image-edit.yaml
!/api/get_edit_res.py
!/api/get_generate_res.py
!/api/get_vlm_res.py
!/api/qwen_image_edit_server.py
!/api/smoke_api.py

# Public utility modules.
!/util/
/util/*
!/util/clinical_text_metrics.py
!/util/format_parser.py
!/util/metrics.py
!/util/prompt.py
!/util/vllm_compat_entrypoint.py

# Defense in depth for credentials, local environments, caches, data, and
# generated evaluation artifacts. Dataset files are distributed externally.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
**/*credential*
**/*secret*
**/*token*
api/config.yaml
api/test.jpg
api/test*.py
**/__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.venv/
venv/
env/
.conda/
.download-python/
external/
data/
datasets/
downloads/
cache/
caches/
outputs/
output/
local_image_outputs/
results/
logs/
eval_results/
eval_results_type_wise/
eval_available/
eval_ready/
experiments/**/runs/
experiments/**/logs/
experiments/**/images/
*.log
*.jsonl
*.sqlite
*.db
